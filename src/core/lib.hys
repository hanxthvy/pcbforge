# Daftar nama ditulis eksplisit, bukan lewat Object.keys().
# Object.keys() memicu helper `dict_keys` dari runtime hydra, dan runtime itu
# mengimpor React di tingkat atas. Mesin inti harus bisa dijalankan di Node
# polos tanpa React terpasang, jadi ia dijaga bebas helper sepenuhnya.
LIB_NAMA = ["CRYSTAL3225", "C_0402", "C_0603", "C_0805", "C_1206", "D_SMA", "D_SOD123", "ESP32WROOM", "LED_0603", "LED_0805", "L_1210", "PINHDR_1x02", "PINHDR_1x04", "QFN24", "QFN32", "R_0402", "R_0603", "R_0805", "R_1206", "SOIC16", "SOIC8", "SOT223", "SOT23", "SW_SPST", "TACT_6MM", "TO220", "TO252", "TSSOP20", "USBC_16P"]

export def lib_names():
    # Daftar nama, untuk ditawarkan ke pengguna dan ke AI. Sudah terurut.
    return LIB_NAMA

export def lib_get(nama):
    if LIB[nama] == undefined:
        return null
    return LIB[nama]

export def lib_ada(nama):
    return LIB[nama] != undefined

